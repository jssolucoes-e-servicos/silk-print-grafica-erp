# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===================================================
# NESTJS EXTERNAL BACKEND API
# ===================================================
# Point frontend requests to your NestJS Backend URL:
# Local dev default: http://localhost:3333/api
# Production default: https://api.silkprint.com.br/api
VITE_API_URL=http://localhost:3333/api

# ===================================================
# POSTGRESQL DATABASE
# ===================================================
# Full connection string or individual parameters:
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSL=false

# ===================================================
# MINIO S3 OBJECT STORAGE
# ===================================================
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=silkprint-files

# ===================================================
# N8N AUTOMATION PLATFORM
# ===================================================
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_ORDER_CREATED=
N8N_WEBHOOK_STATUS_CHANGED=
N8N_WEBHOOK_QUOTE_CREATED=
N8N_WEBHOOK_FINANCIAL_ALERT=

# ===================================================
# EVOLUTION API (WHATSAPP VPS)
# ===================================================
EVOLUTION_API_URL=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_API_KEY=

